<?xml version="1.0" encoding="utf-8"?>
<!-- Official DroidVM artwork (Astrix Tech) is used unchanged as the foreground layer.
     It is scaled to 90dp of the 108dp canvas so that the whole monitor+penguin motif stays
     inside the visible mask area on every launcher shape without distortion. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
